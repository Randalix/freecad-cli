    res["diff"] = st
    return res, 0


SCHOEN_SECTION_DIR = {"x": (68, 16), "y": (-18, 12), "z": (-20, 55)}      # Standard-Blickrichtung (az, el) je Schnittachse im schoenen Stil


def _stl_bbox(path):
    """[xmin, ymin, zmin, xmax, ymax, zmax] einer STL (binaer oder ASCII), nur Standardbibliothek.
    14.11.2026: STL-Teile im Stil schoen hatten kein 'bbox' (KeyError bei wall_y)."""
    import struct
    lo, hi = [float("inf")] * 3, [float("-inf")] * 3

    def add(x, y, z):
        for k, v in enumerate((x, y, z)):
            if v < lo[k]: lo[k] = v
            if v > hi[k]: hi[k] = v
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        head = f.read(84)
        n = struct.unpack("<I", head[80:84])[0] if len(head) == 84 else -1
        if n >= 0 and 84 + 50 * n == size:                       # binaer
            data = f.read()
            for t in struct.iter_unpack("<12fH", data):
                add(*t[3:6]); add(*t[6:9]); add(*t[9:12])
        else:                                                    # ASCII
            f.seek(0)
            for line in f:
                s = line.split()
                if len(s) == 4 and s[0] == b"vertex":
                    add(float(s[1]), float(s[2]), float(s[3]))
    if lo[0] == float("inf"):
        return [0.0] * 6
    return [round(v, 3) for v in lo + hi]


def do_schoen(a, quiet=False, glb_only=False):
    """Stil schoen: Teile exportieren (Worker), Materialien nach Bauteil, Blender-Job (cad_schoen.py), optional GLB."""
    import cad_render as cr
    import cad_schoen as cs
    if not glb_only and (a.diff or a.hotspot or a.focus or a.mode not in (None, "shaded")):
        fail("--style schoen kennt kein --diff/--hotspot/--focus/--mode (dafuer --style technik)", 2)
    src = a.file
    stem = "lauf"
    if src:
        src = os.path.abspath(src)
        if not os.path.isfile(src):
            fail("Datei nicht gefunden: %s" % a.file, 2)
        stem = os.path.splitext(os.path.basename(src))[0]
    if src and src.lower().endswith(".stl"):
        parts = [{"path": src, "name": stem, "mat": cs.default_material(stem), "bbox": _stl_bbox(src)}]
    else:
        try:
            r = call({"op": "export", "file": src, "cwd": os.getcwd()}, a.timeout)
        except Infra as e:
            fail(str(e), 3)
        if r.get("error"):
            fail(r["error"].splitlines()[0], 2)
        parts, stem = r["stls"], r.get("stem", stem)
    # Teile ausblenden
    hide = []
    if a.hide:
        for pat in a.hide.split(","):
            pat = pat.strip()
            hide += [p["name"] for p in parts if (p["name"].startswith(pat[:-1]) if pat.endswith("*") else p["name"] == pat)]
        if not hide:
            fail("--hide: kein Teil passt zu %r (Teile: %s)" % (a.hide, ", ".join(p["name"] for p in parts[:8])), 2)
    if a.explode:
        hide += [p["name"] for p in parts if cs.is_cable(p["name"]) and p["name"] not in hide]
    # Kamera
    try:
        asp = [float(x) for x in (a.aspect or ("4:3" if a.explode else "16:10")).split(":")]
        aspect = asp[0] / asp[1]
        sec = None
        if a.section and not glb_only:
            ax, pos = parse_section(a.section)
            sec = {"axis": ax, "pos": pos}
        if glb_only:
            dirv = [-32, 24]
        elif a.dir:
            dirv = cr.parse_vec(a.dir, 2)
        elif a.view:
            if "," in a.view or a.view not in cr.PRESETS:
                raise ValueError("--style schoen: genau eine --view (iso front back left right top bottom) oder --dir az,el")
            dirv = list(cr.PRESETS[a.view])
        elif sec:
            dirv = list(SCHOEN_SECTION_DIR[sec["axis"]])
        else:
            dirv = [-32, 24]
        at = cr.parse_vec(a.at, 3) if a.at and not glb_only else None
        explode = None
        if a.explode:
            explode = "auto" if a.explode == "auto" else cr.parse_vec(a.explode, 3)
        sofa = cr.parse_vec(a.sofa, 3)
    except (ValueError, ZeroDivisionError) as e:
        fail(str(e), 2)
    if sec and explode:
        fail("--section und --explode lassen sich nicht kombinieren", 2)
    wall_y = a.wall_y if a.wall_y is not None else max(p["bbox"][4] for p in parts if p["name"] not in hide)
    # Dateiname
    tag = []
    if a.room: tag.append("raum")
    if explode: tag.append("explosion")
    if sec: tag.append("schnitt_%s%g" % (sec["axis"], sec["pos"]))
    if not (a.room or explode or sec): tag.append("ansicht")
    out = None
    if not glb_only:
        out = safe_out(a.out or os.path.join(default_dir("vorschau"), "%s_schoen_%s.png" % (stem, "_".join(tag))))
    glb = safe_out(glb_path(a.glb)) if a.glb else None
    caption = []
    if a.room and not explode:
        caption.append("Raum: Wand bei Y=%g mm (aus dem Modell: größtes Y der Teile), Boden Z=0, Sofa %g x %g x %g mm (Schätzung, Rückseite bei Y=0, Rückenlehne dahinter, Blockform)." % (wall_y, *sofa))
    if explode:
        caption.append("Explosionsansicht: Teile entlang ihrer Montagerichtung auseinandergezogen (Abstände %s mm in x, y, z); gestrichelt = Weg; Kabelwege (Prüfkörper) ausgeblendet. Nummer = Eintrag in der Legende." % ("300,250,300 (auto)" if explode == "auto" else ",".join("%g" % v for v in explode)))
    if a.room and explode:
        caption.append("Hinweis: --room wird bei --explode nicht gezeichnet.")
    _grau = [p["name"] for p in parts if (p.get("mat") or cs.default_material(p["name"])) == "grau"]
    if _grau:
        _w = "WARNUNG: kein Material vergeben für %s -> grau gerendert. Material setzen: cad.material(\"Name\", \"pla\") im Skript (eigene Materialien: cad materials list)." % ", ".join(_grau[:6] + (["…"] if len(_grau) > 6 else []))
        caption.append(_w)
        print(_w, file=sys.stderr)
    job = {"parts": [{"path": p["path"], "name": p["name"], "mat": p.get("mat") or cs.default_material(p["name"])} for p in parts],
           "out": out, "px": a.px or 1600, "aspect": aspect, "dir": dirv, "lens": a.lens, "at": at, "size": a.size,
           "room": bool(a.room), "room_cfg": {"wall_y": wall_y, "sofa": sofa}, "explode": explode, "section": sec,
           "samples": a.samples, "engine": a.engine, "bg": a.bg, "hide": hide, "numbers": bool(explode or a.numbers), "dims": a.dims,
           "no_legend": a.no_legend, "caption": caption, "glb": glb, "no_render": glb_only}
    res = cs.run_job(job, timeout=a.timeout)
    if not res.get("ok"):
        if quiet:
            return {"ok": False, "text": "cad: Render fehlgeschlagen: %s" % res.get("error")}, 3
        fail("Render fehlgeschlagen: %s" % str(res.get("error")).strip(), 3)
    if glb_only:
        g = res["glb"]
        res["text"] = "GLB: %s (%.2f MB, %d Meshes, Meter, Y oben; %.1fs gesamt)" % (g["path"], g["bytes"] / 1e6, g["objects"], res["seconds"])
    else:
        res["text"] = cr.legend_text(res)
        td = res.get("time_detail", {})
        res["text"] += "\n  Zeiten: gesamt %.1fs, Blender %.1fs (Texturen %.1fs, Render %.1fs, Nummernpass %.1fs)" % (
            res["seconds"], res.get("blender_seconds", 0), td.get("textures", 0), td.get("render", 0), td.get("idpass", 0))
        for w in res.get("warnings") or []:
            res["text"] += "\n  WARNUNG: " + w
        if res.get("glb"):
            g = res["glb"]
            res["text"] += "\n  GLB: %s (%.2f MB, %d Meshes, %.1fs)" % (g["path"], g["bytes"] / 1e6, g["objects"], g["seconds"])
    return res, 0


