def safe_out(p):
    ap_, rp = os.path.abspath(p), os.path.realpath(p)
    for x in (ap_, rp):
        if WIKI and (x == WIKI or x.startswith(WIKI + os.sep)) and not os.environ.get("CAD_ALLOW_WIKI"):
            fail("Ausgabe in %s verboten (CAD_NO_OUTPUT_DIR) - Bilder gehoeren in die Projektstruktur (cad projekt/cad version)" % p, 2)
    try:
        w = cp.check_write(ap_)
    except cp.Gesperrt as e:
        fail(str(e), 2)
    if w:
        print("[cad] Hinweis: " + w, file=sys.stderr)
    return ap_


_WARNED = set()


def default_dir(kind):
    """Ausgabeordner der aktiven Version (modell|slice|vorschau|messung); ohne Projekt cad_out mit Warnzeile."""
    try:
        d, warn = cp.outdir(kind)
    except cp.Fehler as e:
        fail(str(e), 2)
    if warn and warn not in _WARNED:
        _WARNED.add(warn)
        print("[cad] WARNUNG: " + warn, file=sys.stderr)
    os.makedirs(d, exist_ok=True)
    return d


def glb_path(g):
    """--glb name.glb ohne Ordner -> modell/ der aktiven Version (sonst wie angegeben)."""
    if g and not os.path.dirname(g):
        return os.path.join(default_dir("modell"), g)
    return g


def save_messung(name, data):
    """JSON-Messwerte nach messung/ der aktiven Version (nur mit aktivem Projekt); gibt den Pfad zurueck."""
    p, v, vdir = cp.active()
    if not vdir:
        return None
    try:
        d, _ = cp.outdir("messung")
    except cp.Fehler as e:
        print("[cad] Hinweis: Messwerte nicht gespeichert: %s" % e, file=sys.stderr)
        return None
    f = safe_out(os.path.join(d, name))
    with open(f, "w") as fh:
        json.dump(data, fh, indent=1, ensure_ascii=False, default=str)
    return f


def _intersects(bb, reg, pad=0.0):
    return all(bb[i] <= reg[i + 3] + pad and bb[i + 3] >= reg[i] - pad for i in range(3))


def _frame_box(box, min_half=5.0):
    """Hotspot-Box -> Bildausschnitt: Rand und Mindestgroesse (kleine Stellen werden nicht zum Punkt gezoomt)."""
    ext = [box[i + 3] - box[i] for i in range(3)]
    pad = max(2.0, 0.15 * max(ext))
    out = []
    ctr = [(box[i] + box[i + 3]) / 2 for i in range(3)]
    half = [max(ext[i] / 2 + pad, min_half) for i in range(3)]
    return [ctr[i] - half[i] for i in range(3)] + [ctr[i] + half[i] for i in range(3)]


def _legend_items(mode, cr):
    if mode == "overhang":
        c = cr.OVERHANG_COLORS
        return [{"rgb": c["slant"], "text": "Überhang < 45° (schräg, kritisch)"},
                {"rgb": c["bridge"], "text": "waagerechte Unterseite (Brücke; > 10 mm kritisch, siehe cad hotspots)"},
                {"rgb": c["neutral"], "text": "unkritisch"}]
    if mode == "section":
        return [{"rgb": cr.CAP_COLOR, "text": "Schnittfläche"}]
    return []


def parse_section(spec):
    try:
        k, v = spec.replace(" ", "").split("=")
        if k.lower() not in ("x", "y", "z"):
            raise ValueError
        return k.lower(), float(v.replace(",", "."))
    except ValueError:
        fail("--section erwartet x=Wert, y=Wert oder z=Wert (z. B. --section x=40.35)", 2)


def do_look(a, quiet=False):
    import cad_render as cr
    if a.style == "schoen":
        return do_schoen(a, quiet)
    for opt, val in (("--room", a.room), ("--explode", a.explode), ("--numbers", a.numbers), ("--dims", a.dims), ("--hide", a.hide), ("--lens", a.lens != 40.0),
                     ("--bg", a.bg != "weiss"), ("--engine", a.engine != "eevee"), ("--samples", a.samples != 40), ("--aspect", a.aspect)):
        if val:
            fail("%s gilt nur mit --style schoen" % opt, 2)
    if a.glb:
        gres, gcode = do_schoen(a, quiet, glb_only=True)
        if not quiet:
            print(gres["text"])
        if gcode:
            return gres, gcode
    if a.diff:
        return do_diff(a, cr, quiet)
    src = a.file
    stls, focus, stem = None, [], "lauf"
    if src:
        src = os.path.abspath(src)
        if not os.path.isfile(src):
            fail("Datei nicht gefunden: %s" % a.file, 2)
        stem = os.path.splitext(os.path.basename(src))[0]
    mode = a.mode
    section = None                       # (axis, pos)
    if a.section:
        section = parse_section(a.section)
        mode = mode or "section"
    if a.cut is not None and not a.section:
        if not a.at:
            fail("--cut braucht --at (Zielpunkt); besser --section x|y|z=Wert", 2)
        nm = a.view if a.view and "," not in a.view else None
        if nm not in PRESET_AXIS:
            fail("--cut braucht eine achsparallele --view (front back left right top bottom); sonst --section benutzen", 2)
        ax, sg = PRESET_AXIS[nm]
        at = cr.parse_vec(a.at, 3)
        section = (ax, at["xyz".index(ax)] - sg * a.cut)
        mode = mode or "section"
    if mode == "section" and not section and not a.hotspot:
        fail("--mode section braucht --section x|y|z=Wert (oder --hotspot N)", 2)
    isolate = not a.no_isolate
    need_worker = bool(a.hotspot or section or a.focus or not src or not src.lower().endswith(".stl"))
    h = None
    contours = {}
    assess = {}
    req = {"op": "look", "file": src, "cwd": os.getcwd(), "hotspot": a.hotspot, "min_wall": a.min_wall, "profile": a.profile,
           "components": bool(isolate and (a.hotspot or section or a.focus)), "mode": mode}
    if a.focus:
        req["assess_focus"] = a.focus
    if section:
        req["section"] = {"axis": section[0], "pos": section[1]}
    if need_worker:
        try:
            r = call(req, a.timeout)
        except Infra as e:
            fail(str(e), 3)
        if r.get("error"):
            fail(r["error"].splitlines()[0], 2)
        stls, focus, stem, zref = r["stls"], r.get("focus", []), r.get("stem", stem), r.get("zref")
        h = r.get("hotspot")
        contours = r.get("contours") or {}
        assess = r.get("assess") or {}
    else:
        stls, zref = [{"path": src, "name": stem, "item": 0, "comp": None}], None
    views, tag, sheet = [], "", False
    px = a.px
    only_sets = []                       # je Ansicht: Indizes der sichtbaren Modelle (None = alle)
    caption, notes = [], []
    sec_job = None

    def isolate_for(region, pad=0.5):
        if not isolate or not all(s.get("comp") is not None for s in stls):
            return None
        keep = [i for i, s in enumerate(stls) if _intersects(s["bbox"], region, pad)]
        return keep if keep and len(keep) < len(stls) else None

    def iso_text(keep, prefix=""):
        """Kurz: 'N von M Teilen, ausgeblendet: a, b, c (+k)'; sichtbare Teile nur namentlich, wenn es hoechstens 4 sind."""
        if keep is None:
            return None
        hid = [s["name"] for i, s in enumerate(stls) if i not in keep]
        shown = (" (%s)" % ", ".join(stls[i]["name"] for i in keep)) if len(keep) <= 4 else ""
        return "%s%d von %d Teilen%s, ausgeblendet: %s%s" % (prefix, len(keep), len(stls), shown, ", ".join(hid[:3]), " (+%d)" % (len(hid) - 3) if len(hid) > 3 else "")

    try:
        if h and not a.focus:
            tag = "hotspot%d" % a.hotspot
            hmode = mode or h["mode"]
            box = _frame_box(h["box"])
            if hmode == "section" and (section or h.get("section")):
                ax, pos = section or (h["section"]["axis"], h["section"]["pos"])
