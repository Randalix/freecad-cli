        names[0], names[1], st["added_area"], st["removed_area"], st["volume_old"], st["volume_new"], st["dvolume"],
        st["bbox_old"][3] - st["bbox_old"][0], st["bbox_old"][4] - st["bbox_old"][1], st["bbox_old"][5] - st["bbox_old"][2],
        st["bbox_new"][3] - st["bbox_new"][0], st["bbox_new"][4] - st["bbox_new"][1], st["bbox_new"][5] - st["bbox_new"][2]),
        "Verfahren: Flächenabstand beider Netze (Toleranz %.2f mm), kein Volumen-Boolean: eine Fläche gilt als neu/entfernt, wenn mehr als die Hälfte ihrer Punkte weiter als die Toleranz vom anderen Netz entfernt ist" % st["tol"]]
    out = safe_out(a.out or os.path.join(default_dir("vorschau"), "%s_%s.png" % (r["stem"], tag)))
    job = {"models": [{"path": f["path"], "color": f["color"]} for f in r["stls"]], "out": out, "views": views, "sheet": sheet,
           "edges": a.edges, "ruler": not a.no_ruler, "mode": a.mode if a.mode in ("xray", "wire") else "shaded", "caption": cap, "legend_items": items}
