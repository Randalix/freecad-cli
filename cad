    if hs:
        print("Ansehen: cad look %s--hotspot N%s" % (p + " " if p else "", " --profile moebel" if a.profile == "moebel" else ""))
    sys.exit(code)


def _line_specs(a):
    import linienwand as LW
    try:
        return LW, [(x.strip(), LW.parse_lw(x)) for x in a.line_w.split(",") if x.strip()]
    except ValueError:
        fail("--line-w erwartet Linienbreiten, z. B. 0.6 oder 0.42/0.45 (außen/innen) oder std, mehrere mit Komma", 2)


def group_walls(walls, tol=0.025):
    """Wandstuecke gleicher Dicke (+/- tol) und gleichen Teils zu einer Zeile: Flaeche summiert, Ort = groesstes Stueck."""
    groups = []
    for w in sorted(walls, key=lambda w: w["t"]):
        key = tuple(w.get("part_names") or [])
        g = next((g for g in groups if g["key"] == key and abs(w["t"] - g["t_last"]) <= tol), None)
        if g is None:
            g = {"key": key, "items": [], "t_last": w["t"]}
            groups.append(g)
        g["items"].append(w); g["t_last"] = w["t"]
    out = []
    for g in groups:
        it = g["items"]; big = max(it, key=lambda w: w["area"]); A = sum(w["area"] for w in it)
        t = sum(w["t"] * w["area"] for w in it) / A if A else big["t"]
        axes = sorted(set(w["axis"] for w in it))
        out.append({"t": round(t, 3), "t_min": min(w["t_min"] for w in it), "t_max": max(w["t_max"] for w in it), "area": A, "n": len(it),
                    "center": big["center"], "axis": "/".join(axes), "part_names": list(g["key"])})
    out.sort(key=lambda w: -w["area"])
    return out


def print_line_table(a, walls):
    """Tabelle `cad check --line-w`: je Wand Dicke, Spuren, Rest, Urteil je Linienbreite (Modell linienwand.py)."""
    LW, specs = _line_specs(a)
    h, loops = a.layer_h, a.loops
    print("Wandstärke vs. Linienbreite (OrcaSlicer classic, Wandlinien %d, Schicht %.2f; Modell kalibriert an Slicer-Schätzung, nicht gedruckt):" % (loops, h))
    for name, (wo, wi) in specs:
        fen = ", ".join("%.2f–%.2f (%d Sp.)" % (max(lo, 1.4 * wo if n == 2 else lo), hi - (0.07 if n == 2 else 0.015), n) for lo, hi, n in LW.fenster(wo, wi, h, loops))
        print("  Linien %s (außen %.2f / innen %.2f, Spurabstand %.3f): gap-frei bei %s mm" % (name, wo, wi, LW.spacing(wi, h), fen))
    if walls is None:
        return 0
    if not walls:
        print("  keine senkrechten Wände bis %.1f mm Dicke gefunden" % a.t_max)
        return 0
    if not a.stellen:
        walls = group_walls(walls)
    hdr = "%3s %6s %8s %6s  %-24s %-3s" % ("Nr", "Dicke", "Fläche", "Stellen", "Ort (x, y, z) mm (größte)", "N")
    for name, _ in specs:
        hdr += " | %-44s" % ("Linien " + name + ": Spuren, Rest, Urteil")
    print(hdr)
    n_hint = 0
    for i, w in enumerate(walls[:a.max], 1):
        tt = w["t"]
        rng = "" if w["t_max"] - w["t_min"] < 0.03 else " (%.2f–%.2f)" % (w["t_min"], w["t_max"])
        line = "%3d %6.2f %6.0fmm² %6d  (%6.1f,%6.1f,%6.1f)     %-3s" % (i, tt, w["area"], w.get("n", 1), *w["center"], w["axis"])
        for name, (wo, wi) in specs:
            m = LW.spuren(tt, wo, wi, h, loops)
            nom_n = max(1, round(tt / wo))
            cell = "%s: %s; Rest %+.2f (nominal %d×%.2f %+.2f)" % (m["urteil"], m["text"], m["rest"], nom_n, wo, tt - nom_n * wo)
            if m["urteil"] != "ok":
                n_hint += 1
                if "erschöpft" in m["text"] and LW.spuren(tt, wo, wi, h, loops + 1)["urteil"] == "ok":
                    cell += " -> ok mit --loops %d" % (loops + 1)
                ns = LW.naechste_saubere(tt, wo, wi, h, loops)
                if ns is not None:
                    cell += " -> sauber z. B. %.2f" % ns
            line += " | " + cell
        print(line + rng + (" | Teil %s" % ", ".join(w["part_names"]) if w.get("part_names") else ""))
    if len(walls) > a.max:
        print("  ... %d weitere Wände (--max)" % (len(walls) - a.max))
    print("  Urteil ok = Rest <= 0,015 mm (2 Außenspuren: <= 0,07); darüber Gap-Fill über die ganze Wandhöhe. Rest = Dicke - 2 x Kante der innersten Spur;"
          " 'nominal' = Dicke - n x Linienbreite nur zur Info (classic legt Spuren paarweise von beiden Seiten).")
    return n_hint


def cmd_check(a):
    if a.line_w and a.wand:
        LW, specs = _line_specs(a)
        try:
            ts = [float(x.replace(",", ".")) for x in a.wand.split(";") if x] if ";" in a.wand else [float(x) for x in a.wand.split(",")]
        except ValueError:
            fail("--wand erwartet Dicken in mm, z. B. 1.6,1.8", 2)
        walls = [{"t": t, "t_min": t, "t_max": t, "area": 0, "center": [0, 0, 0], "axis": "-"} for t in ts]
        print("cad check --wand (nur Rechner, kein Modell)")
        print_line_table(a, walls)
        sys.exit(0)
    p = _src_arg(a)
    if not p and a.file is None:
        pass
    try:
        bed = [float(x) for x in a.bed.lower().replace("x", ",").split(",")]
        if len(bed) != 3:
            raise ValueError
    except ValueError:
        fail("--bed erwartet BxTxH, z. B. 256x256x256", 2)
    try:
        r = call({"op": "check", "file": p, "cwd": os.getcwd(), "bed": bed, "min_wall": a.min_wall, "profile": a.profile,
                  "line_walls": bool(a.line_w), "t_max": a.t_max}, a.timeout)
    except Infra as e:
        fail(str(e), 3)
    if r.get("error"):
        fail(r["error"].splitlines()[0], 2)
    if a.json:
        mf = save_messung("check_%s.json" % (os.path.splitext(os.path.basename(p))[0] if p else "lauf"), r)
        if mf:
            print("[cad] Messwerte: %s" % mf, file=sys.stderr)
        print(json.dumps(r, indent=1))
        sys.exit(r["exit"])
    print("cad check %s (Bett %gx%gx%g%s): %s" % (os.path.basename(p) if p else "(letzter Lauf)", *bed, ", Profil moebel" if a.profile == "moebel" else "", "BEFUND" if r["exit"] else "ok"))
    for it in r["items"]:
        print("  %-4s %-12s %s" % (it["status"], it["check"], it["text"]))
    if r.get("hint"):
        print("  " + r["hint"])
    if r["exit"]:
        print("  Details und Stellen: cad hotspots %s%s" % (p or "", " --profile moebel" if a.profile == "moebel" else ""))
    if a.line_w:
        print()
        print_line_table(a, r.get("line_walls", []))
    sys.exit(r["exit"])


# ------------------------------------------------------------------------------------------------ worker
def cmd_worker(a):
    if a.action == "status":
        s = status()
        if a.json:
            print(json.dumps(s or {"ok": False, "state": "off"}))
        elif s:
            print("worker laeuft (pid %d, FreeCAD %s): %s%s, Laeufe %d, Leerlauf %ds von %ds, Warteschlange %d" % (
                s["pid"], s["freecad"], s["state"], " (%s seit %.0fs)" % (s["script"], s["busy_seconds"]) if s["script"] else "",
                s["runs"], s["idle_seconds"], s["idle_limit"], s["queued"]))
        else:
            print("worker aus (startet bei `cad run` von selbst)")
        sys.exit(0)
    if a.action == "stop":
        subprocess.run(["systemctl", "--user", "stop", "cadworker.service"], check=False)
        print("worker gestoppt")
        sys.exit(0)
    if a.action == "restart":
        subprocess.run(["systemctl", "--user", "restart", "cadworker.service"], check=False)
        try:
            for _ in range(150):
                s = status()
                if s:
                    print("worker neu gestartet (pid %d)" % s["pid"])
                    sys.exit(0)
                time.sleep(0.2)
        except KeyboardInterrupt:
            pass
        fail("Worker startet nicht (journalctl --user -u cadworker -n 20)", 3)


def cmd_materials(a):
    import cad_schoen as cs
    cur = {k: dict(v) for k, v in cs.USER_MATERIALS.items()}
    if a.action == "list":
        print("Eingebaut (mit Textur): eiche, multiplex, hartholz; platzhalter (blau)")
        for k, m in cur.items():
            print("%-12s %-22s rgb=%s rough=%s metal=%s aliases=%s match=%s" % (k, m.get("label", k), m["rgb"], m.get("rough", 0.5), m.get("metal", 0), m.get("aliases", []), m.get("match", "-")))
        if not cur:
            print("(keine eigenen Materialien; Datei: %s)" % cs.MATERIALS_FILE)
        return
    if not a.key:
        fail("cad materials %s: Schluessel fehlt" % a.action, 2)
    k = a.key.strip().lower()
    if a.action == "rm":
        if k not in cur:
            fail("unbekanntes Material %r" % k, 2)
        del cur[k]
        cs.save_user_materials(cur)
        print("entfernt:", k)
        return
    if not a.rgb:
        fail("cad materials add: --rgb fehlt (z.B. --rgb 0.3,0.55,0.62)", 2)
    if k in ("eiche", "multiplex", "hartholz", "platzhalter"):
        fail("%r ist eingebaut" % k, 2)
    rgb = [float(x) for x in a.rgb.split(",")]
    if len(rgb) != 3 or not all(0 <= x <= 1 for x in rgb):
        fail("--rgb: drei Werte 0..1", 2)
    cur[k] = {"label": a.label or k, "rgb": rgb, "rough": a.rough, "metal": a.metal,
              "aliases": [x.strip() for x in (a.alias or "").split(",") if x.strip()]}
    if a.match:
        cur[k]["match"] = a.match
    cs.save_user_materials(cur)
    print("gespeichert:", k, "->", cs.MATERIALS_FILE)


