def cmd_projekt(a):
    try:
        if a.name in (None, "show"):
            info = cp.projekt_show(a.extra)
            if a.json:
                print(json.dumps(info, indent=1, ensure_ascii=False)); return
            st = cp.load_state()
            print("Projekt %s (%s)%s, aktuell -> %s" % (info["projekt"], info["pfad"], "  [aktiv]" if st.get("projekt") == info["projekt"] else "", info["aktuell"] or "-"))
            for r in info["versionen"]:
                print("  %s %-45s %3d Dateien%s" % ("*" if r["aktiv"] else " ", r["version"], r["dateien"], "  FREIGEGEBEN" if r["freigabe"] else ""))
            if info["experimente"]:
                print("  experimente/: " + ", ".join(info["experimente"]))
            return
        if a.name == "list":
            st = cp.load_state()
            rows = cp.projekt_list()
            if a.json:
                print(json.dumps({"aktiv": st, "projekte": rows}, indent=1, ensure_ascii=False)); return
            for r in rows:
                print("%s %-22s %2d Versionen, neueste %s" % ("*" if st.get("projekt") == r["projekt"] else " ", r["projekt"], r["versionen"], r["neueste"] or "-"))
            if not rows:
                print("(keine Projekte mit PROJEKT.md unter %s)" % cp.ROOT)
            return
        if a.name == "aus":
            cp.clear()
            print("kein aktives Projekt mehr (Ausgaben wieder nach %s, mit Warnung)" % cp.FALLBACK)
            return
        d, neu, made, v = cp.set_projekt(a.name)
        print("aktives Projekt: %s (%s)%s" % (a.name, d, " - neu angelegt" if neu else ""))
        if made:
            print("  angelegt: %s (bitte Zweck/Vorgaben eintragen)" % ", ".join(made))
        print("  aktive Version: %s" % (v or "keine - erst cad version \"<Label>\""))
    except cp.Fehler as e:
        fail(str(e), 2)


def cmd_version(a):
    try:
        if a.nutze:
            p, v = cp.set_version(a.nutze)
            print("aktive Version: %s/%s (aktuell bleibt unveraendert)" % (p, v))
            return
        if not a.label:
            p, v, vdir = cp.active()
            if not p:
                fail(cp.WARN_FALLBACK, 2)
            print("%s/%s%s" % (p, v or "(keine Version)", "  FREIGEGEBEN" if cp.is_frozen(vdir) else ""))
            if vdir:
                print(vdir)
            return
        p, v, vdir, basis, link_err = cp.new_version(a.label, a.basiert_auf)
        print("neue Version: %s/%s%s" % (p, v, " (basiert auf %s)" % basis if basis else ""))
        print("  %s/{%s}" % (vdir, ",".join(cp.KINDS)))
        print("  %s, CHANGELOG.md ergaenzt; Ausgaben von cad look/run gehen jetzt dorthin" % ("aktuell -> " + v if not link_err else "aktuell NICHT gesetzt"))
        if link_err:
            print("[cad] WARNUNG: " + link_err, file=sys.stderr)
    except cp.Fehler as e:
        fail(str(e), 2)


def cmd_freigabe(a):
    try:
