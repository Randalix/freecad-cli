    print("cad hotspots %s: %d Treffer (%d Dreiecke, %d Teil(e), Analyse %.1fs; Grenzen: %s)" % (
        os.path.basename(p) if p else "(letzter Lauf)", len(hs), sc["triangles"], sc["parts"], r["analysis_seconds"] + sc["build_seconds"], lim))
    for h in hs[:a.max]:
        b = h["box"]
        print("%2d [%s] %s | bei (%.1f, %.1f, %.1f) Box x %.1f..%.1f y %.1f..%.1f z %.1f..%.1f%s" % (
            h["n"], SEV_MARK[h["severity"]].strip(), h["reason"], *h["center"], b[0], b[3], b[1], b[4], b[2], b[5],
            " | Teil %s" % ", ".join(h["part_names"]) if h.get("part_names") and sc["parts"] > 1 else ""))
    if len(hs) > a.max:
        print("  ... %d weitere (--max oder --json)" % (len(hs) - a.max))
    if r.get("hint"):
