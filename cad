#!/usr/bin/env python3
"""cad - FreeCAD fuer Agenten ohne GUI: ausfuehren, messen, ansehen, pruefen.

  cad run <skript.py> [--report] [--look [ansicht]] [-k] [-v] [--json] [--timeout S] [-- args]
  cad run -c "<code>"
  cad info <datei.FCStd|step|stl>
  cad look [datei] [--view iso|front|back|left|right|top|bottom[,..]] [--dir az,el] [--at x,y,z --size mm] [--box x0,y0,z0,x1,y1,z1]
           [--mode shaded|wire|xray|overhang|section] [--section x=40.35] [--hotspot N] [--focus all|NAME] [--diff ALT NEU]
           [--no-isolate] [--px N] [--persp] [-o bild.png] [--json]
  cad look [datei] --style schoen [--room] [--explode dx,dy,dz|auto] [--section x=..] [--lens 40] [--dir=az,el] [--at x,y,z --size mm]
           [--engine eevee|cycles] [--hide NAME,..] [--bg weiss|grau|transparent] [--glb out.glb]   (Stil fuer Menschen: Materialien, Perspektive, Schatten)
  cad run <skript> --glb out.glb                      GLB (Meter, Y oben, Teile als benannte Meshes, PBR); im Skript: cad.material(name, "eiche|multiplex|hartholz|platzhalter|<eigene>")
  cad materials list|add KEY --rgb r,g,b [--label --rough --metal --alias a,b --match REGEX]|rm KEY   eigene Materialien (materials.json), fuer alle Modelle
  cad hotspots [datei] [--min-wall 0.8] [--json]     kritische Stellen nummeriert (duenne Wand, Ueberhang/Bruecke, Spalt, offenes Netz, Fokus)
  cad check [datei] [--bed 256x256x256] [--json]     Druckbarkeit: Bett, geschlossen, Ueberhang, duenne Wand, Spalt, Teileabstand
  cad worker status|stop|restart
  cad projekt <name> | list | show [name] | aus      aktives Projekt setzen (legt /mnt/raid1/3d_print/<name>/ mit PROJEKT.md/CHANGELOG.md an)
  cad version "<Label>" [--basiert-auf vNNN] | --nutze vNNN    neue Version vNNN_<datum>_<label>/{modell,slice,vorschau,messung}, setzt `aktuell`
  cad freigabe "<Notiz>"                              freigabe.md in der aktiven Version (nur auf ausdruecklichen Wunsch des Nutzers); danach ist die Version gesperrt
Ohne Datei arbeiten look/hotspots/check auf dem letzten Lauf im Worker. Nach Aenderungen an cadgeom.py/cadlib.py: cad worker restart.
Exit: 0 ok, 1 Befund (hotspots: hoch/mittel; check: WARN/FAIL; info: ungueltige Form), 2 Skriptfehler/Aufruffehler, 3 Infrastruktur (Worker/Blender).
Ausgaben: aktive Version <projekt>/vNNN_.../vorschau|modell|messung (ohne Projekt Fallback cad_out mit Warnung; nie in CAD_NO_OUTPUT_DIR), Bilder mit Textlegende. `cad look` ohne Argumente = Sheet (iso, front, right, top) mit mm-Lineal;
Zoom mit --at/--size; --focus/--hotspot/--section zeigen nur die betroffenen Teile (--no-isolate = alle); cad.focus(name, center, size, view) im Skript."""
import argparse, json, os, socket, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import cadprojekt as cp  # noqa: E402  Projektstruktur/Versionen (14.11.2026)
OUT_ROOT = os.environ.get("CAD_OUT", "/mnt/raid1/3d_print/cad_out")
WIKI = os.environ.get("CAD_NO_OUTPUT_DIR", "")   # optional: Ordner, in den cad keine Ausgabe schreiben darf (z. B. ein Notizen-Vault)


class Infra(Exception):
    pass


def sock_path():
    d = os.environ.get("XDG_RUNTIME_DIR")
    if not d or not os.path.isdir(d):
        d = "/run/user/%d" % os.getuid()
        if not os.path.isdir(d):
            d = "/tmp"
    return os.path.join(d, "cadworker.sock")


SOCK = sock_path()


def raw_call(req, timeout):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(3)
    s.connect(SOCK)
    s.settimeout(timeout)
    s.sendall((json.dumps(req) + "\n").encode())
    f = s.makefile("rb")
    while True:
        line = f.readline()
        if not line:
            raise Infra("Worker hat ohne Antwort aufgelegt (Absturz? naechster Aufruf startet ihn neu, sonst: cad worker restart)")
        msg = json.loads(line.decode())
        if msg.get("event") == "queued":
            print("[cad] Worker beschaeftigt, %d vor dir - warte ..." % msg["ahead"], file=sys.stderr)
            continue
        return msg


def status():
    try:
        return raw_call({"cmd": "status"}, 3)
    except (OSError, ValueError, Infra):
        return None


def ensure():
    if status():
        return
    subprocess.run(["systemctl", "--user", "start", "--no-block", "cadworker.service"], check=False)
    for _ in range(150):
        if status():
            return
        time.sleep(0.2)
    raise Infra("Worker startet nicht (journalctl --user -u cadworker -n 20)")


def call(req, timeout=900):
    """Anfrage an den Worker. Infrastrukturfehler -> Infra mit Hinweis."""
    ensure()
    try:
        return raw_call(req, timeout)
    except socket.timeout:
        raise Infra("Zeitueberschreitung nach %ds - Skript haengt? Abbruch: cad worker restart" % timeout)
    except (OSError, ValueError) as e:
        raise Infra("Worker nicht erreichbar (%s) - cad worker restart" % e)


def fail(msg, code):
    print("cad: " + msg, file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------------------------------------ run
def cmd_run(a):
    req = {"op": "run", "keep": a.keep, "cwd": os.getcwd(), "args": a.args, "report": a.report or a.json,
           "projekt": dict(cp.load_state(), state_file=cp.state_file())}
    if a.code is not None:
        req["code"] = a.code
    else:
        if not a.script:
            fail("run: Skript oder -c <code> angeben", 2)
        p = os.path.abspath(a.script)
        if not os.path.isfile(p):
            fail("Skript nicht gefunden: %s" % a.script, 2)
        req["file"] = p
    t0 = time.time()
    cold = status() is None
    try:
        r = call(req, a.timeout)
    except Infra as e:
        fail(str(e), 3)
    out = {"ok": r.get("ok", False), "stdout": r.get("stdout", ""), "error": r.get("error"),
           "seconds": r.get("seconds"), "report": r.get("report"), "focus": r.get("focus", [])}
    code = 0
    if r.get("error"):
        code = 2
    elif r.get("report") and any(not m.get("valid", True) for m in r["report"]):
        code = 1
    look = None
    if a.look and code != 2:
        lopts = look_parser().parse_args(["--view", a.look] if a.look != "sheet" else [])
        lopts.json = a.json
        look, lcode = do_look(lopts, quiet=True)
        if lcode:
            code = max(code, 3 if lcode == 3 else code)
        out["look"] = look
    glb = None
    if a.glb and code != 2:
        lopts = look_parser().parse_args(["--glb", a.glb])
        glb, gcode = do_schoen(lopts, quiet=True, glb_only=True)
        out["glb"] = {k: glb.get(k) for k in ("ok", "text", "glb")}
        if gcode:
            code = max(code, 3)
    out["exit"] = code
    if a.report and out["report"]:
        stem = os.path.splitext(os.path.basename(a.script or "code"))[0]
        mf = save_messung("report_%s.json" % stem, {"skript": req.get("file"), "zeit": time.strftime("%Y-%m-%d %H:%M:%S"), "report": out["report"]})
        if mf:
            out["report_json"] = mf
            print("[cad] Messwerte: %s" % mf, file=sys.stderr)
    if a.json:
        print(json.dumps(out, indent=1, ensure_ascii=False))
        sys.exit(code)
    sys.stdout.write(out["stdout"])
    if out["report"] and not r.get("report_printed"):
        for m in out["report"]:
            print("[report] " + m.get("text", m.get("error", "?")))
    if r.get("error"):
        print(r["error"], file=sys.stderr)
        if a.verbose and r.get("traceback"):
            print(r["traceback"], file=sys.stderr)
    if look:
        print(look["text"])
    if glb:
        print(glb["text"])
    if out["focus"]:
        print("[cad] Fokus-Bereiche: %s  (cad look --focus all)" % ", ".join(f["name"] for f in out["focus"]), file=sys.stderr)
    if r.get("warning"):
        print("[cad] Hinweis: " + r["warning"], file=sys.stderr)
    print("[cad] %s, Skript %.2fs, gesamt %.2fs (%s)" % ("Fehler" if r.get("error") else "ok", r.get("seconds", 0),
          time.time() - t0, "Worker kalt gestartet" if cold else "Worker warm"), file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------------------------------------ info
def cmd_info(a):
    p = os.path.abspath(a.file)
    if not os.path.isfile(p):
        fail("Datei nicht gefunden: %s" % a.file, 2)
    try:
        r = call({"op": "info", "file": p, "cwd": os.getcwd()}, a.timeout)
    except Infra as e:
        fail(str(e), 3)
    if r.get("error"):
        fail(r["error"].splitlines()[0], 2)
    info = r["info"]
    code = 1 if any(not m.get("valid", True) for m in info) else 0
    if a.json:
        print(json.dumps({"file": p, "objects": info, "exit": code}, indent=1))
    else:
        for m in info:
            print(m["text"])
    sys.exit(code)


