# Beispiel fuer ~/.config/cad/env (oder Pfad in CAD_CONFIG). Zeilen KEY=VALUE, Umgebungsvariablen haben Vorrang.
#
# Ort dieses Repos (Worker findet seine Module) und Wurzel der Projektordner
# CAD_DIR=/home/user/tools/freecad-cli
# CAD_PROJEKT_ROOT=/home/user/cad-projekte
# Ausgaben ohne aktives Projekt
# CAD_OUT=/home/user/cad-projekte/cad_out
# Blender-Programm, falls nicht im PATH
# CAD_BLENDER=/opt/blender/blender
# Ordner, in den cad nie Bilder schreiben soll (z. B. ein Notizen-Vault)
# CAD_NO_OUTPUT_DIR=/home/user/notizen
# Projekte auf einer Netzfreigabe ohne Symlink-Unterstuetzung: Symlinks per ssh auf dem Dateiserver anlegen
# CAD_SYMLINK_HOST=user@fileserver
# CAD_REMOTE_PATH_MAP=/mnt/share/=/srv/share/
